{
  "name": "pulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @pulse/api dev\" \"pnpm --filter @pulse/web dev\"",
    "build": "pnpm --filter @pulse/shared build && pnpm --filter @pulse/web build && pnpm --filter @pulse/api build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "hash-password": "node scripts/hash-password.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
